# ─── Prime Auto — доступ к твоему дилерскому кабинету ─────────────────
# Скопируй этот файл в .env и впиши свои данные:
#     cp .env.example .env
# Файл .env в .gitignore и НИКОГДА не попадёт в git.

# Логин и пароль от твоего кабинета на primeauto.ge
PRIMEAUTO_LOGIN=
PRIMEAUTO_PASSWORD=

# Страница входа (по умолчанию — стандартный кабинет WooCommerce)
PRIMEAUTO_LOGIN_URL=https://primeauto.ge/my-account/

# Показывать окно браузера при логине (нужно, чтобы пройти капчу/2FA руками).
# true  — окно видно (рекомендуется для первого входа)
# false — фоновый режим (когда сессия уже настроена)
PRIMEAUTO_HEADFUL=true
